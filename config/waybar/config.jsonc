{
    "layer": "top",
    "position": "top",
    "height": 32,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "network",
        "battery",
        "custom/vpn",
        "custom/audio",
        "custom/power"
    ],
    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true,
        "tooltip": true
    },
    "custom/audio": {
        "exec": "~/.config/hypr/scripts/get-audio.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) {ipaddr}",
        "tooltip-format-ethernet": "{ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "custom/vpn": {
        "exec": "/home/usein/.config/hypr/scripts/vpn-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-charging": "  {capacity}%",
        "tooltip-format": "{timeTo} {capacity}%"
    },
    "custom/power": {
        "format": "",
        "on-click": "~/.config/hypr/scripts/power-menu.sh",
        "tooltip": "Power menu"
    },
    "clock": {
        "format": "{:%H:%M  %a %d %b}",
        "interval": 60,
        "tooltip-format": "{:%A %d %B %Y}",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d"
    }
}
