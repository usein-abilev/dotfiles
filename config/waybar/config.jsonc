{
  "layer": "top",
  "position": "top",
  "height": 0,
  "margin": "5",
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
      "cpu",
      "memory",
      "network",
      "battery",
      "pulseaudio",
      "temperature",
      "custom/power"
  ],

  // --- Modules ---
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name} {icon}",
    "format-icons": {
      // "1": "",
      // "2": "",
      // "3": "",
      // "4": "",
      // "5": "",
      "active": "",
      "default": ""
    }
  },

  "clock": {
    "format": "{:%a, %b %d  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 60,
    "on-click": "swaync-client -t -s"
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 5
  },

  "memory": {
    "format": " {used} / {total:0.0f}Gb",
    "interval": 5
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "  {ipaddr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} {ipaddr}/{cidr}",
    "interval": 10,
    "on-click": "nm-connnection-editor"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "interval": 30
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "  Mute",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "temperature": {
      "critical-threshold": 80,
      "format": " {temperatureC}°C"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout"
  }
}

