@theme "/dev/null"

configuration {
    show-icons: true;
}

* {
    font:   "SF Pro Text 12";

    /* ---- GNOME Adwaita Dark palette ---- */
    base:           #1e1e1e;
    surface:        #2a2a2a;
    surface-alt:    #333333;
    border:         #444444;

    accent:         #3584e4;
    accent-hover:   #4a90d9;

    text-primary:   #ffffff;
    text-secondary: #e6e6e6;
    text-tertiary:  #969696;
    text-muted:     #555555;

    background-color: transparent;
    text-color:       @text-primary;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    width:          480px;
    border-radius:  16px;

    background-color: @base;
    border:          1px;
    border-color:    @border;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color: @surface;
    border:          2px;
    border-color:    @accent;
    border-radius:   12px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: @text-tertiary;
    str: "  ";
}

entry {
    placeholder:        "Search";
    placeholder-color:  @text-muted;
}

listview {
    background-color: transparent;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;

    fixed-height: false;
    dynamic:    true;
}

element {
    padding:        4px 12px;
    spacing:        8px;
    border-radius:  8px;
}

element normal active {
    text-color: @accent;
}

element alternate active {
    text-color: @accent;
}

element selected normal,
element selected active {
    background-color: @accent;
    text-color:       @text-primary;
}

element-icon {
    size:           24px;
    vertical-align: 1.5;
}

element-text {
    text-color: inherit;
}

scrollbar {
    handle-width: 4px;
    handle-color: @text-tertiary;
    padding:      0 4px;
}
