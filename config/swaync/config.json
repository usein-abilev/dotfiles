{
    "positionX": "right",
    "positionY": "top",
    "control-center-positionX": "right",
    "control-center-positionY": "top",
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 0,
    "control-center-margin-left": 0,
    "notification-icon-size": 32,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "timeout": 10,
    "timeout-low": 5,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "control-center-width": 380,
    "control-center-height": -1,
    "notification-window-width": 420,
    "keyboard-shortcuts": true,
    "image-visibility": "always",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "widgets": [
        "mpris",
        "calendar",
        "buttons-grid",
        "volume",
        "backlight",
        "dnd"
    ],
    "widget-config": {
        "title": {
            "text": "Quick Settings",
            "clear-all-button": false,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "buttons-grid": {
            "buttons-per-row": 3,
            "actions": [
                {
                    "id": "wifi",
                    "label": "\uf1eb    WiFi",
                    "command": "/home/usein/.config/hypr/scripts/wifi-toggle.sh",
                    "type": "toggle",
                    "update-command": "sh -c 'nmcli radio wifi | grep -q enabled && echo true || echo false'"
                },
                {
                    "id": "bluetooth",
                    "label": "\uf294  Bluetooth",
                    "command": "/home/usein/.config/hypr/scripts/bluetooth-toggle.sh",
                    "type": "toggle",
                    "update-command": "sh -c 'bluetoothctl show | grep \"Powered:\" | awk \"{print \\$2}\" | grep -q yes && echo true || echo false'"
                },
                {
                    "id": "night",
                    "label": "\uf186  Night Light",
                    "command": "/home/usein/.config/hypr/scripts/night-toggle.sh",
                    "type": "toggle",
                    "update-command": "sh -c '[ -f /tmp/hyprsunset-mode ] && echo true || echo false'"
                },
                {
                    "id": "vpn",
                    "label": "\uf023  VPN",
                    "command": "/home/usein/.config/hypr/scripts/vpn-toggle.sh",
                    "type": "toggle",
                    "update-command": "sh -c 'nmcli -t -f NAME,TYPE con show --active | grep -q \":vpn\" && echo true || echo false'"
                },
                {
                    "id": "settings",
                    "label": "\uf013  Settings",
                    "command": "gnome-control-center",
                    "type": "normal"
                },
                {
                    "id": "logout",
                    "label": "\uf08b  Logout",
                    "command": "hyprctl dispatch 'hl.dsp.exit()'",
                    "type": "normal"
                }
            ]
        },
        "mpris": {
            "image-size": 40,
            "image-radius": 6
        },
        "volume": {
            "label": "Volume",
            "show-per-app": true,
            "step": 5
        },
        "backlight": {
            "label": "Brightness",
            "step": 5
        }
    }
}
