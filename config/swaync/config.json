{
    "positionX": "right",
    "positionY": "top",
    "control-center-positionX": "right",
    "control-center-positionY": "top",
    "control-center-margin-top": 32,
    "control-center-margin-bottom": 0,
    "control-center-margin-right": 0,
    "control-center-margin-left": 0,
    "notification-icon-size": 32,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,
    "timeout": 10,
    "timeout-low": 5,
    "timeout-critical": 0,
    "fit-to-screen": true,
    "control-center-width": 420,
    "control-center-height": -1,
    "notification-window-width": 420,
    "keyboard-shortcuts": true,
    "image-visibility": "always",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "widgets": [
        "title",
        "dnd",
        "buttons-grid",
        "volume",
        "backlight",
        "mpris",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Control Center",
            "clear-all-button": true,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "buttons-grid": {
            "buttons-per-row": 3,
            "actions": [
                {
                    "id": "wifi",
                    "label": "WiFi",
                    "command": "/home/usein/.config/hypr/scripts/wifi-toggle.sh",
                    "type": "toggle"
                },
                {
                    "id": "bluetooth",
                    "label": "Bluetooth",
                    "command": "/home/usein/.config/hypr/scripts/bluetooth-toggle.sh",
                    "type": "toggle"
                },
                {
                    "id": "night",
                    "label": "Night",
                    "command": "/home/usein/.config/hypr/scripts/night-toggle.sh",
                    "type": "toggle"
                },
                {
                    "id": "vpn",
                    "label": "VPN",
                    "command": "/home/usein/.config/hypr/scripts/vpn-toggle.sh",
                    "type": "toggle"
                },
                {
                    "label": "Logout",
                    "command": "hyprctl dispatch 'hl.dsp.exit()'",
                    "type": "normal"
                },
                {
                    "label": "Shutdown",
                    "command": "systemctl poweroff -i",
                    "type": "normal"
                }
            ],
            "state": "/home/usein/.config/hypr/scripts/status.sh"
        },
        "mpris": {
            "image-size": 48,
            "image-radius": 8
        },
        "volume": {
            "label": "Volume",
            "show-per-app": true,
            "step": 5
        },
        "backlight": {
            "label": "Brightness",
            "step": 5
        }
    }
}
